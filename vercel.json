{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0",
            "maxDuration": 15
        }
    },
    "routes": [
        { "src": "/assets/(.*)", "dest": "/assets/$1" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ],
    "headers": [
        {
            "source": "/assets/(.*)",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=604800, immutable" }
            ]
        }
    ],
    "env": {
        "NMA_BASE_URL": "/",
        "NMA_DEBUG": "0",
        "NMA_DEMO": "1"
    }
}
